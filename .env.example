# 1. Google Gemini API Key
# Free from: https://aistudio.google.com
# Purpose: Script generation (LLM), RAG embeddings, and thumbnail generation.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LeetCode Session Cookie
# From: leetcode.com (Browser DevTools)
# Purpose: Scraping your accepted C++ solutions & details.
LEETCODE_SESSION=your_leetcode_session_cookie_here

# 3. YouTube OAuth Client File Path (Optional / Default path: config/client_secrets.json)
# From: Google Cloud Console (console.cloud.google.com)
YOUTUBE_CLIENT_SECRETS_PATH=config/client_secrets.json
# 4. LLM Model Selection
# Override the default models used by the LLM clients.
# GEMINI_MODEL=gemini-3.5-flash
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Gemini Media Generation (Phase 13/14)
# Uncomment to use Gemini for audio (TTS) and video (Veo) generation instead of Kokoro and Manim
# GEMINI_AUDIO_MODEL=gemini-2.5-flash
# GEMINI_VIDEO_MODEL=veo-3.1
